root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,md,mmd,sql}]
indent_size = 4

[*.svg]
insert_final_newline = unset

[__init__.py]
insert_final_newline = unset

[*.csv]
indent_style = unset
indent_size = unset
